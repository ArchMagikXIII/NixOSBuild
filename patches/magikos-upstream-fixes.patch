diff --git a/bin/magikos-openrc-user-services b/bin/magikos-openrc-user-services
index 269d4e59..1047811d 100755
--- a/bin/magikos-openrc-user-services
+++ b/bin/magikos-openrc-user-services
@@ -1,8 +1,14 @@
 #!/bin/bash
+
+# magikos:summary=Start Artix's packaged OpenRC user services
+# magikos:group=openrc
+# magikos:name=user services
+# magikos:examples=magikos openrc user services
+
 # Start Artix's packaged OpenRC USER services, not untracked duplicate daemons.
 set -euo pipefail
 
-command -v rc-update >/dev/null 2>&1 || exit 0
+magikos-cmd-missing rc-update && exit 0
 for service in pipewire wireplumber pipewire-pulse; do
   [[ -f ${MAGIKOS_OPENRC_USER_INIT_DIR:-/etc/user/init.d}/$service ]] || continue
   rc-update --user add "$service" default
